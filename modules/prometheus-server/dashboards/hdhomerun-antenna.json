      "targets": [
        {
          "expr": "hdhomerun_channel_virtual_info{device=\"192.168.8.103\",tuner=~\"$tuner\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "device": true
            },
            "renameByName": {
              "tuner": "Tuner",
              "channel": "RF Channel",
              "vchannel": "Virtual Channel",
              "guide_name": "Guide Name"
            }
          }
        }
      ],
      "options": {
