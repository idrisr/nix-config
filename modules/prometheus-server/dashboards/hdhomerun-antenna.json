{
  "id": null,
  "uid": "hdhomerun-antenna",
  "title": "HDHomeRun Antenna Placement",
  "tags": [
    "tv",
    "antenna",
    "hdhomerun"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "device",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "effpfi5egefwgf"
        },
        "query": "label_values(hdhomerun_up, device)",
        "includeAll": false,
        "multi": false,
        "current": {
          "selected": true,
          "text": "192.168.8.103",
          "value": "192.168.8.103"
        }
      },
      {
        "name": "tuner",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "effpfi5egefwgf"
        },
        "query": "label_values(hdhomerun_tuner_locked{device=\"$device\"}, tuner)",
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": ".*"
        },
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "HDHomeRun Reachable",
      "datasource": {
        "type": "prometheus",
        "uid": "effpfi5egefwgf"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "expr": "max(hdhomerun_up{device=\"$device\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down"
                },
                "1": {
                  "text": "Up"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "Tuner 0 Lock",
      "datasource": {
        "type": "prometheus",
        "uid": "effpfi5egefwgf"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 28
      },
      "targets": [
        {
          "expr": "max(hdhomerun_tuner_locked{device=\"$device\",tuner=\"tuner0\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Unlocked"
                },
                "1": {
                  "text": "Locked"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
