        "x": 12,
        "y": 28
      },
      "targets": [
        {
          "expr": "max(hdhomerun_tuner_locked{device=\"$device\",tuner=\"tuner1\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Unlocked"
